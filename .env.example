# NetraAI example configuration (placeholders only).
# Copy to `.env` for local use. Never commit `.env`.
# Password values below are placeholders: replace them locally and never reuse a placeholder in any
# shared or deployed environment.
# Nothing reads these values until Phase 2.

APP_ENV=development
LOG_LEVEL=info

# Ports
API_PORT=8000
WEB_PORT=5173

# Database: MySQL (primary database). MYSQL_* names follow the official MySQL container image.
MYSQL_DATABASE=netra
MYSQL_USER=netra_app
MYSQL_PASSWORD=CHANGE_ME_APP_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
# SQLAlchemy URL. Host is `localhost` outside Compose and the MySQL service name inside Compose.
# Keep user, password and database consistent with the MYSQL_* values above.
DATABASE_URL=mysql+pymysql://netra_app:CHANGE_ME_APP_PASSWORD@localhost:3306/netra?charset=utf8mb4

# Storage (local paths; both locations are git-ignored)
IMAGE_STORAGE_DIR=./data/images
MODEL_DIR=./models

# Inference: "stub" is the deterministic placeholder with no clinical meaning
INFERENCE_BACKEND=stub
MODEL_VERSION=stub-0

# Referral rules: TBD, thresholds are unvalidated placeholder configuration until clinically validated
REFERRAL_RULES_PATH=

# Uploads (placeholder value, tune later)
MAX_UPLOAD_MB=10

# UI locales (placeholders)
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,hi
